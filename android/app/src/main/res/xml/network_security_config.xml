<?xml version="1.0" encoding="utf-8"?>
<!-- 仅放行局域网 http 明文访问（网关主机为 http://IP:8080） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
